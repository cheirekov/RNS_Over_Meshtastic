{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "python312@latest",
    "uv@latest",
    "mosquitto@latest"
  ],
  "shell": {
    "init_hook": [
      "uv sync --extra dev"
    ],
    "scripts": {
      "test": "uv run pytest",
      "lint": "uv run ruff check .",
      "mqtt-broker": "mosquitto -c docker/mosquitto/mosquitto.conf"
    }
  }
}

