# Complete Linux gateway environment reference.
#
# The new 0.3 settings have safe defaults and are not mandatory in an existing
# file. Topology still determines its required fields: the shown
# gateway_unicast/hub profile needs MESHTASTIC_TCP_HOST and RNS_ALLOWED_NODES;
# auto_multi_peer/hub needs only MESHTASTIC_TCP_HOST; gateway_unicast/client
# additionally needs RNS_GATEWAY_NODE.
# Keep the real file outside version control and mode 0600 when it has IFAC
# passphrases. Values are single-line and are not shell-expanded by the app.

# ---------------------------------------------------------------------------
# Meshtastic radio connection
# ---------------------------------------------------------------------------

# Required IP address or hostname of the Meshtastic radio.
MESHTASTIC_TCP_HOST=192.0.2.10
# Meshtastic TCP API port, 1..65535. Firmware default: 4403.
MESHTASTIC_TCP_PORT=4403
# Local Meshtastic channel slot used for broadcast packets, 0..7. Meshtastic
# unicast DM/PKI routing is Node-ID based and can report a different slot.
MESHTASTIC_CHANNEL_INDEX=0
# Meshtastic radio hop limit, 0..7. Three is the recommended shared-mesh limit.
MESHTASTIC_HOP_LIMIT=3
# inherit: allow MQTT forwarding when the radio permits it.
# force_off: mark bridge packets as not eligible for Meshtastic MQTT forwarding.
MESHTASTIC_MQTT_FORWARDING_POLICY=inherit

# Meshtastic duty-cycle override is deliberately unsupported and must remain
# disabled in radio firmware. The gateway never enables it.

# ---------------------------------------------------------------------------
# Reticulum over Meshtastic topology
# ---------------------------------------------------------------------------

# gateway_unicast: fixed hub/client relationship.
# auto_multi_peer: Linux hub learns multiple Android/radio peers dynamically.
# broadcast: channel broadcast; Linux role must be client.
RNS_MESH_MODE=gateway_unicast
# hub or client. auto_multi_peer requires hub; broadcast requires client.
RNS_GATEWAY_ROLE=hub
# Required only for gateway_unicast/client: remote Meshtastic Node ID.
RNS_GATEWAY_NODE=
# Comma-separated !aabbcc11 Node IDs. Required for gateway_unicast/hub.
# Optional ingress allowlist for auto_multi_peer; empty then permits discovery.
RNS_ALLOWED_NODES=!a1b3b3b8
# Maximum learned auto_multi_peer radios, 1..512. Default: 32.
RNS_MAX_PEERS=32

# ---------------------------------------------------------------------------
# LoRa airtime protection
# ---------------------------------------------------------------------------

# conservative: recommended for shared/community RF.
# balanced: controlled private RF with a larger/faster queue.
# custom: explicit expert values; Console displays a warning.
RNS_LORA_POLICY=conservative
# Minimum seconds between Meshtastic transmissions, 0.25..60.
# conservative default 2.0; balanced default 1.0.
RNS_RADIO_TX_INTERVAL=2.0
# Complete-frame queue admission limit in fragments, 4..1024.
# conservative default 32; balanced default 64.
RNS_RADIO_QUEUE_FRAGMENTS=32
# Maximum repair requests in the rolling window, 1..120.
RNS_REPAIR_REQUEST_BUDGET=12
# Repair rolling-window duration in seconds, 10..3600.
RNS_REPAIR_BUDGET_WINDOW=60

# ---------------------------------------------------------------------------
# Public Reticulum boundaries and LAN visibility
# ---------------------------------------------------------------------------

# Optional comma-separated host:port list, maximum eight endpoints. IPv6 uses
# [address]:port. Each connection is rendered as a boundary with
# announces_from_internal=No; public announces are not exported to LoRa.
RNS_PUBLIC_UPSTREAMS=
# no: LAN listener follows the private/internal radio boundary.
# yes: trusted LAN/VPN clients can see public announces without making LoRa a
# public transit interface. This is an explicit visibility opt-in.
RNS_LAN_PUBLIC_VISIBILITY=no

# off: no Reticulum interface discovery (default).
# manual: collect candidates in Console, but never autoconnect.
# trusted_auto: autoconnect only through RNS_DISCOVERY_SOURCES identities.
RNS_PUBLIC_DISCOVERY=off
# Comma-separated 32-hex discovery source identity hashes. Empty is valid for
# off and manual; trusted_auto requires at least one identity.
RNS_DISCOVERY_SOURCES=
# Maximum trusted automatically connected interfaces, 1..8.
RNS_DISCOVERY_MAX=1

# ---------------------------------------------------------------------------
# Optional Reticulum IFAC protection
# ---------------------------------------------------------------------------

# Each name/passphrase pair must be either both empty or both configured.
# Configured passphrases must be at least 12 characters. Radio and TCP IFAC
# credentials must be different. Secrets are redacted by Console/API/logs.
RNS_RADIO_IFAC_NAME=
RNS_RADIO_IFAC_PASSPHRASE=
RNS_TCP_IFAC_NAME=
RNS_TCP_IFAC_PASSPHRASE=

# ---------------------------------------------------------------------------
# LAN/VPN Reticulum listener and diagnostics
# ---------------------------------------------------------------------------

# Host address on which Docker publishes the Reticulum TCP listener. Keep
# 127.0.0.1 unless clients connect through a trusted LAN/VPN address.
RNS_TCP_PUBLISH_IP=127.0.0.1
# Reticulum TCP listener port, 1..65535.
RNS_TCP_LISTEN_PORT=4242
# Reticulum log level, 0..7. Default 4 is suitable for field diagnostics.
RNS_LOGLEVEL=4

# Unprivileged Gateway Console. It has no browser-triggered restart, no Docker
# socket and no authentication in v1. Keep it on loopback or a protected VPN.
RNS_CONSOLE_PUBLISH_IP=127.0.0.1
RNS_CONSOLE_PORT=8787

# ---------------------------------------------------------------------------
# LXMD propagation node / relay
# ---------------------------------------------------------------------------

LXMD_NODE_NAME=RNS Meshtastic Propagation
LXMD_DISPLAY_NAME=RNS Meshtastic Service
# Propagation announce interval in minutes, 60..10080.
LXMD_ANNOUNCE_INTERVAL=360
# Minimum seconds between operator-triggered propagation announces. Console
# enforces an absolute minimum of five minutes; 15 minutes is the safe default.
LXMD_MANUAL_ANNOUNCE_COOLDOWN_SECONDS=900
# yes/no: automatic propagation peering. Default no protects LoRa and storage.
LXMD_AUTOPEER=no
# yes/no: accept propagation sync offers only from static peers. Recommended yes.
LXMD_FROM_STATIC_ONLY=yes
# Message store limit in MB, 8..4096.
LXMD_STORAGE_LIMIT_MB=64
# Maximum accepted propagation message in KB, 1..256.
LXMD_MESSAGE_MAX_KB=8
# Maximum propagation sync transfer in KB, 8..10240.
LXMD_SYNC_MAX_KB=64
# yes/no: require propagation-client identity authentication.
LXMD_AUTH_REQUIRED=no
# Required when authentication is yes: comma-separated 32-hex identity hashes.
LXMD_ALLOWED_IDENTITIES=
# LXMD log level, 0..7.
LXMD_LOGLEVEL=4
