# Copy this file outside version control and replace every CHANGE-ME value.
MESHTASTIC_TCP_HOST=192.0.2.10
MESHTASTIC_TCP_PORT=4403
MESHTASTIC_CHANNEL_INDEX=0
MESHTASTIC_HOP_LIMIT=3
MESHTASTIC_MQTT_FORWARDING_POLICY=inherit

RNS_MESH_MODE=gateway_unicast
RNS_GATEWAY_ROLE=hub
RNS_GATEWAY_NODE=
RNS_ALLOWED_NODES=!a1b3b3b8
RNS_MAX_PEERS=32

# Optional outbound public Reticulum boundaries. Add at most eight explicit
# host:port endpoints, separated by commas. Empty keeps public connectivity off.
# When non-empty, the radio and private TCP listener become `internal`, while
# every public connection is `boundary` with private announce export disabled.
RNS_PUBLIC_UPSTREAMS=

# For Android auto_multi_peer discovery, use auto_multi_peer/hub. The allowlist
# remains optional in that explicit mode: empty is open radio ingress, while a
# comma-separated list restricts which Meshtastic radios can create peers.
# RNS_MESH_MODE=auto_multi_peer
# RNS_ALLOWED_NODES=

# IFAC is optional. Leave both values in an interface pair empty to disable it.
RNS_RADIO_IFAC_NAME=
RNS_RADIO_IFAC_PASSPHRASE=
RNS_TCP_IFAC_NAME=
RNS_TCP_IFAC_PASSPHRASE=
RNS_TCP_PUBLISH_IP=127.0.0.1
RNS_TCP_LISTEN_PORT=4242

LXMD_NODE_NAME=RNS Meshtastic Propagation
LXMD_DISPLAY_NAME=RNS Meshtastic Service
LXMD_ANNOUNCE_INTERVAL=360
LXMD_AUTOPEER=no
# Reject propagation-node sync offers from arbitrary public nodes. Direct local
# client offers still use the normal client delivery path.
LXMD_FROM_STATIC_ONLY=yes
LXMD_STORAGE_LIMIT_MB=64
LXMD_MESSAGE_MAX_KB=8
LXMD_SYNC_MAX_KB=64
LXMD_AUTH_REQUIRED=no
# If authentication is enabled, add comma-separated 32-character identity hashes.
LXMD_ALLOWED_IDENTITIES=
