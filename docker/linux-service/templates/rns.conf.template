[reticulum]
  enable_transport = Yes
  share_instance = Yes
  instance_name = meshtastic-linux-service
$RNS_DISCOVERY_BLOCK

[logging]
  loglevel = $RNS_LOGLEVEL

[interfaces]
  [[Meshtastic radio hub]]
    type = RNSMeshtasticInterface
    enabled = Yes
    mode = $RNS_RADIO_INTERFACE_MODE

    transport = native
    connection = tcp
    tcp_host = $MESHTASTIC_TCP_HOST
    tcp_port = $MESHTASTIC_TCP_PORT
    channel_index = $MESHTASTIC_CHANNEL_INDEX
    hop_limit = $MESHTASTIC_HOP_LIMIT
    mqtt_forwarding_policy = $MESHTASTIC_MQTT_FORWARDING_POLICY
    tx_interval = $RNS_RADIO_TX_INTERVAL
    max_queued_fragments = $RNS_RADIO_QUEUE_FRAGMENTS
    repair_request_budget = $RNS_REPAIR_REQUEST_BUDGET
    repair_budget_window = $RNS_REPAIR_BUDGET_WINDOW
    telemetry_file = /data/rns/meshtastic-telemetry.json

    mesh_mode = $RNS_MESH_MODE
    gateway_role = $RNS_GATEWAY_ROLE
    $RNS_GATEWAY_NODE_LINE
    accept_broadcast_on_hub = $RNS_ACCEPT_BROADCAST_ON_HUB
    max_peers = $RNS_MAX_PEERS
    peer_announce_idle_timeout = $RNS_PEER_ANNOUNCE_IDLE_SECONDS
    $RNS_ALLOWED_NODES_LINE
    want_ack = No
    pki_required = No

$RNS_RADIO_IFAC_BLOCK

  [[LAN VPN Reticulum clients]]
    type = TCPServerInterface
    enabled = Yes
    mode = $RNS_LAN_INTERFACE_MODE
    listen_ip = 0.0.0.0
    listen_port = $RNS_TCP_LISTEN_PORT

$RNS_TCP_IFAC_BLOCK

$RNS_BOUNDARY_UPSTREAM_BLOCK
